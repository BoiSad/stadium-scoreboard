root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120

[*.{ts,tsx,js,jsx,json,css,html,yml,yaml}]
indent_size = 2

[*.md]
# Dwie spacje na końcu linii to w Markdownie twarde złamanie wiersza.
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
